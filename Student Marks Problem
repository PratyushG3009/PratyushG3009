//Maximum 
marks = [
    [0, 1, 2],
    [50, 85, 80],
    [60, 95, 35],
    [70, 65, 68],
    [85, 55, 65],
    [80, 85, 90]
]

maximum = max(max(row) for row in marks)

print("Maximum marks =", maximum)

//Minimum 
minimum = min(min(row) for row in marks)

print("Minimum marks =", minimum)

//Average 
total = 0
count = 0

for row in marks:
    for value in row:
        total = total + value
        count = count + 1

average = total / count

print("Average marks =", average)

