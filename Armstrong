def checkArmstrong(num):
    original = num
    digits = len(str(num))
    sum = 0

    while num > 0:
        digit = num % 10
        sum = sum + digit ** digits
        num = num // 10

    if sum == original:
        return True
    else:
        return False

num = int(input("Enter a number: "))

if checkArmstrong(num):
    print("Armstrong number")
else:
    print("Not an Armstrong number")
