//Calculate Tranpose and Rank

import numpy as np

A = np.array([
    [1, 2, 3, 4],
    [5, 6, 7, 8],
    [2, 4, 6, 8],
    [1, 3, 5, 7]
])

transpose = np.transpose(A)
rank = np.linalg.matrix_rank(A)

print("Transpose:")
print(transpose)

print("Rank =", rank)


//Calculte Eigenvalues and Eigenvectors

import numpy as np

A = np.array([
    [1, 2, 0, 0],
    [0, 3, 0, 0],
    [0, 0, 4, 1],
    [0, 0, 0, 5]
])

values, vectors = np.linalg.eig(A)

print("Eigenvalues:")
print(values)

print("Eigenvectors:")
print(vectors)


